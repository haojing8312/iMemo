# ==========================================
# HomeMemo 图像生成 API 配置
# ==========================================

# 选择使用的 AI 图像生成模型
# 可选值: gemini | seedream
# 默认: gemini
ANEXT_PUBLIC_AI_IMAGE_MODEL=gemini

# ==========================================
# Google Gemini 配置 (默认模型)
# ==========================================
# 获取 API Key: https://ai.google.dev/gemini-api/docs
NEXT_PUBLIC_NANO_BANANA_API_KEY=your_google_api_key_here
NEXT_PUBLIC_NANO_BANANA_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ==========================================
# SeeDream 4.0 配置 (BytePlus 官方)
# ==========================================
# BytePlus 官方 API
# 注册地址: https://www.byteplus.com/en/product/Seedream
# 价格: $0.03/图
# 免费额度: 200 张图片
NEXT_PUBLIC_SEEDREAM_API_KEY=your_byteplus_api_key_here
NEXT_PUBLIC_SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com
NEXT_PUBLIC_SEEDREAM_MODEL=doubao-seedream-4-0-250828

# ==========================================
# 使用说明
# ==========================================
# 1. 复制此文件为 .env.local:
#    cp .env.local.example .env.local
#
# 2. 选择要使用的模型,修改 AI_IMAGE_MODEL:
#    - gemini: Google Gemini 2.5 Flash (免费/收费)
#    - seedream: SeeDream 4.0 (BytePlus 官方,中文友好,200张免费)
#
# 3. 填入对应模型的 API Key
#
# 4. 重启开发服务器:
#    pnpm dev
#
# 详细文档: docs/multi-model-api-guide.md
